{
  "name": "Kernel 4.6 NetICMP - ramdisk",
  "target": "linux/amd64",
  "http": ":56741",
  "workdir": "workdir",
  "kernel_obj": "/work/linux-4.6",
  "syzkaller": "/home/runner/work/syzkaller/syzkaller",
  "sshkey": "ssh/mykey",
  "sandbox": "none",
  "reproduce": false,
  "procs": 2,
  "type": "qemu",
  "image": "dummy.img",
  "enable_syscalls": [
	  "syz_emit_ethernet$icmp",
	  "syz_extract_tcp_res$icmp",

	  "socket$inet_udp",
	  "socket$inet_tcp",
	  "socket$inet_icmp_raw",
	  "bind$inet_syz_local",
	  "connect$inet_syz_remote",
	  "close"
  ],
  "vm": {
    "count": 2,
    "kernel": "/work/linux-4.6/bzImage",
    "initrd": "initramfs-new.cpio.gz",
    "cmdline": "console=ttyS0 root=/dev/ram0 nokaslr",
    "cpu": 2,
    "mem": 2048
  }
}
