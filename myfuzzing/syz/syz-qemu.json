{
  "name": "Kernel 6 neticmp - ramdisk",
  "target": "linux/amd64",
  "http": ":56741",
  "workdir": "workdir",
  "kernel_obj": "/home/runner/work/test-ci/test-ci/linux-oem-6.0-6.0.0",
  "syzkaller": "/home/runner/work/syzkaller/syzkaller",
  "sshkey": "ssh/mykey",
  "sandbox": "none",
  "reproduce": false,
  "procs": 2,
  "type": "qemu",
  "image": "dummy.img",
  "enable_syscalls": [
    "syz_emit_ethernet$icmp",
    "syz_extract_tcp_res",

    "socket$inet_udp",
    "socket$inet_tcp",
    "socket$inet_icmp_raw",
    "bind$inet",
    "connect$inet",
    "close"
  ],
  "cover_filter": [
    {
      "name": "icmp",
      "filter": {
        "files": [
          "^net/ipv4/icmp\\.c$",
          "^net/ipv4/raw\\.c$",
          "^net/ipv4/udp\\.c$",
          "^net/ipv4/tcp_ipv4\\.c$",
          "^net/ipv4/route\\.c$"
        ]
      },
      "weight": 3.0
    },
    { "name": "rest", "weight": 1.0 }
  ],
  "vm": {
    "count": 2,
    "kernel": "/home/runner/work/test-ci/test-ci/linux-oem-6.0-6.0.0/bzImage",
    "initrd": "initramfs-new.cpio.gz",
    "cmdline": "console=ttyS0 root=/dev/ram0 nokaslr",
    "cpu": 2,
    "mem": 2048
  }
}
