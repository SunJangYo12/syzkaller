{
  "name": "Kernel 6 - ramdisk",
  "target": "linux/amd64",
  "http": ":56741",
  "workdir": "workdir",
  "kernel_obj": "/home/runner/work/syzkaller/syzkaller/linux-6-source",
  "kernel_src": "/home/runner/work/syzkaller/syzkaller/linux-6-source",
  "kernel_build_src": "/home/runner/work/test-ci/test-ci/linux-6-source",
  "syzkaller": "/home/runner/work/syzkaller/syzkaller",
  "sshkey": "ssh/mykey",
  "procs": 4,
  "type": "qemu",
  "image": "dummy.img",
  "enable_syscalls": [
	  "syz_emit_ethernet",
	  "syz_extract_tcp_res",
	  "syz_extract_tcp_res$synack",

	  "socket$inet_tcp",
	  "bind$inet",
	  "listen",
	  "accept$inet",

	  "socket$inet6_tcp",
	  "bind$inet6",
	  "accept$inet6",

	  "socket$inet_udp",
	  "close"
  ],
  "vm": {
    "count": 4,
    "kernel": "/home/runner/work/syzkaller/syzkaller/linux-6-source/bzImage",
    "initrd": "initramfs-new.cpio.gz",
    "cmdline": "console=ttyS0 root=/dev/ram0",
    "cpu": 2,
    "mem": 2048
  }
}
