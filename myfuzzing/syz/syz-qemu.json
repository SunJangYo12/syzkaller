{
  "name": "Kernel 6 ARP & state - ramdisk",
  "target": "linux/amd64",
  "http": ":56741",
  "workdir": "workdir",
  "kernel_obj": "/home/runner/work/test-ci/test-ci/linux-oem-6.0-6.0.0",
  "syzkaller": "/home/runner/work/syzkaller/syzkaller",
  "sshkey": "ssh/mykey",
  "sandbox": "none",
  "procs": 2,
  "type": "qemu",
  "image": "dummy.img",
  "enable_syscalls": [
      "syz_emit_ethernet$arp",

	  "socket$inet_udp",
	  "bind$inet",
	  "connect$inet",
	  "sendto$inet_syz_tun",
	  "close",

	  "ioctl$sock_inet_SIOCSARP",
	  "ioctl$sock_inet_SIOCDARP",
	  "ioctl$syz_tun_SIOCGIFINDEX",

	  "socket$nl_route",
	  "sendmsg$nl_route_neigh",

	  "openat$arp_sysctl",
	  "write$arp_sysctl"
  ],
  "vm": {
    "count": 2,
    "kernel": "/home/runner/work/test-ci/test-ci/linux-oem-6.0-6.0.0/bzImage",
    "initrd": "initramfs-new.cpio.gz",
    "cmdline": "console=ttyS0 root=/dev/ram0 nokaslr",
    "cpu": 2,
    "mem": 2048
  }
}
